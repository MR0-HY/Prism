<Window x:Class="DesktopAgent.Windows.Configuration.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prism · 设置" Width="660" Height="810" MinWidth="560" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource PageBrush}" Icon="../Presentation/prism.ico">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24">
  <DockPanel><Button Content="完成" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="Done_Click"/><StackPanel><TextBlock Text="让 Prism 适合你" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="外观、连接与桌面操作偏好" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,22"/></StackPanel></DockPanel>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><DockPanel><TextBlock Text="主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Width="160" HorizontalAlignment="Right" SelectionChanged="Theme_Changed"><ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/></ComboBox></DockPanel><TextBlock Text="关闭主窗口后留在托盘。右键托盘图标可暂停、停止或退出。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="模型连接" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="使用你自己的 API，密钥加密保存在这台电脑。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,18"/>
   <StackPanel x:Name="ConfigFields">
    <TextBlock Text="提供商" Margin="0,0,0,6"/><ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed"/>
    <TextBlock Text="API 地址" Margin="0,14,0,6"/><TextBox x:Name="BaseBox" TextChanged="Endpoint_Changed"/>
    <TextBlock Text="模型名称" Margin="0,14,0,6"/><TextBox x:Name="ModelBox"/>
    <TextBlock Text="API 密钥" Margin="0,14,0,6"/><PasswordBox x:Name="KeyBox" MaxLength="8192"/>
    <TextBlock x:Name="KeyHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <Expander Header="请求详情"><TextBlock x:Name="EndpointText" TextWrapping="Wrap" FontSize="11" Margin="0,8" Foreground="{DynamicResource MutedBrush}"/></Expander>
   </StackPanel>
   <Border Background="{DynamicResource AccentSoftBrush}" Padding="12" CornerRadius="10" Margin="0,16,0,0"><TextBlock x:Name="ResultText" Text="连接模型并验证后，即可开始桌面任务。" TextWrapping="Wrap" FontSize="12"/></Border>
   <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="SaveButton" Content="保存连接" Click="Save_Click" Margin="0,0,8,8"/><Button x:Name="HybridButton" Content="验证辅助定位" Style="{StaticResource PrimaryButton}" Click="Hybrid_Click" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock Text="保存不会发送请求。验证会发送两个自有测试窗口的截图，共 2 次模型请求，不操作键鼠。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
   <Expander Header="更多验证选项"><StackPanel Margin="0,10,0,0"><TextBlock Text="纯视觉验证使用 8 次模型请求，可能产生费用。验证期间 Ctrl+Alt+F9 可取消。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,10,0,0"><Button x:Name="ProbeButton" Content="验证纯视觉（8次）" Click="Probe_Click" Margin="0,0,8,8"/><Button x:Name="DiagnosticButton" Content="旧提示对照（2次）" Click="Diagnostic_Click" Visibility="Collapsed"/></WrapPanel></StackPanel></Expander>
   <Button x:Name="CancelProbeButton" Content="取消测试" Click="CancelProbe_Click" HorizontalAlignment="Right" Margin="0,10,0,0" IsEnabled="False"/>
  </StackPanel></Border>
  <TextBlock Text="执行任务时，相关界面截图和控件文字会发送至你选择的模型。暂停、等待确认和停止时会释放桌面控制。" Margin="4,16,4,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
 </StackPanel></ScrollViewer>
</Window>