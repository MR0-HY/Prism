<Window x:Class="DesktopAgent.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prism · 棱镜" Width="740" Height="720" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Icon="Presentation/prism.ico">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="34,22,34,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,34">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ConnectionButton" Click="Settings_Click" Style="{StaticResource QuietButton}" ToolTip="配置模型连接"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionText" Text="连接模型" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button><Button Content="⚙" FontSize="18" Style="{StaticResource QuietButton}" Click="Settings_Click" AutomationProperties.Name="设置" ToolTip="设置"/></StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource PrismGradient}" Margin="0,0,10,0"><Path Data="M 8,24 L 16,7 L 25,24 Z M 16,7 L 16,24 M 8,24 L 20,16" Stroke="White" StrokeThickness="1.4"/></Border><TextBlock Text="Prism" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="棱镜" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,24">
   <TextBlock Text="把想法，交给桌面。" FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="今天想让我帮你做什么？" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
  </StackPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
   <StackPanel>
    <Grid><TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskInput" Height="112" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14,14" FontSize="15" BorderThickness="0" TextChanged="Task_Changed" PreviewKeyDown="Task_KeyDown"/><TextBlock x:Name="TaskPlaceholder" Text="例如，把系统外观调成浅色…" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Margin="15,15,0,0" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TaskBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <DockPanel Margin="8,0,8,8"><Button x:Name="StartButton" DockPanel.Dock="Right" Content="开始任务  ↗" Padding="20,10" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Start_Click" AutomationProperties.Name="开始任务"/><TextBlock Text="自然语言输入 · Ctrl + Enter 开始" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <WrapPanel><Button Content="☼  调整系统设置" Tag="打开设置，把系统外观调成浅色" Click="Example_Click" Margin="0,0,8,8"/><Button Content="▦  操作应用" Tag="打开计算器，计算 (3+2+5) × (3+2+5)" Click="Example_Click" Margin="0,0,8,8"/><Button Content="▤  整理文件" Tag="打开资源管理器，显示文件扩展名" Click="Example_Click" Margin="0,0,0,8"/></WrapPanel>
   <DockPanel Margin="0,9,0,0"><TextBlock Text="●" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" AutomationProperties.AutomationId="TaskStatus" Text="准备就绪，等待你的想法" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/></DockPanel>
   <Border x:Name="ApprovalPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="请确认这一步操作" FontWeight="SemiBold"/><ScrollViewer MaxHeight="120" Margin="0,8" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ApprovalDetails" AutomationProperties.AutomationId="ActionApprovalDetails" TextWrapping="Wrap"/></ScrollViewer><WrapPanel HorizontalAlignment="Right"><Button x:Name="RejectActionButton" Content="取消" Margin="0,0,8,0" Click="RejectAction_Click"/><Button x:Name="ApproveActionButton" Content="批准这一步" Style="{StaticResource PrimaryButton}" Click="ApproveAction_Click"/></WrapPanel></StackPanel></Border>
   <StackPanel x:Name="ReplyPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="回复后继续原任务" FontWeight="Medium" Margin="0,0,0,8"/><TextBox x:Name="ReplyBox" AutomationProperties.AutomationId="QuestionReply" Height="64" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap"/><Button x:Name="ReplyButton" Content="发送并继续" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Reply_Click"/></StackPanel>
   <Button x:Name="EnableHighRiskButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0" Click="EnableHighRisk_Click" AutomationProperties.AutomationId="EnableHighRiskAndResume"><TextBlock Text="启用高风险并继续 · 提交前仍需逐次确认" TextWrapping="Wrap"/></Button>
   <Expander x:Name="TaskDetailsExpander" Header="任务详情与本次对话">
    <StackPanel Margin="0,10,0,2"><StackPanel x:Name="ModelReplyPanel" Visibility="Collapsed"><TextBlock Text="理解与计划" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ModelReplyText" AutomationProperties.AutomationId="ModelInterpretation" TextWrapping="Wrap" Margin="0,6"/></ScrollViewer></StackPanel><TextBlock x:Name="CurrentText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="StatsText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6"/><ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" MaxHeight="180"><StackPanel x:Name="Messages"/></ScrollViewer></StackPanel>
   </Expander>
   <Expander Header="运行选项" Margin="0,10,0,0"><StackPanel Margin="0,10,0,0"><ComboBox x:Name="ProfileBox" DisplayMemberPath="Label" SelectionChanged="Profile_Changed"/><TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,8"/><WrapPanel><CheckBox x:Name="UseControls" Content="控件辅助定位" IsChecked="True" Margin="0,4,18,4"/><CheckBox x:Name="HighRiskMode" Content="高风险操作（逐次确认）" IsChecked="False" Checked="HighRiskMode_Changed" Unchecked="HighRiskMode_Changed" AutomationProperties.AutomationId="HighRiskMode"/></WrapPanel></StackPanel></Expander>
  </StackPanel>
  <WrapPanel Grid.Row="4" Margin="0,18,0,0"><Button x:Name="NewTaskButton" Content="新任务" Style="{StaticResource QuietButton}" Margin="0,0,6,0" Click="NewTask_Click" AutomationProperties.AutomationId="NewTask"/><Button x:Name="ResumeButton" Content="继续" IsEnabled="False" Margin="0,0,6,0" Click="Resume_Click"/><Button x:Name="PauseButton" Content="暂停" Margin="0,0,6,0" Click="Pause_Click"/><Button x:Name="StopButton" Content="停止" Foreground="{DynamicResource DangerBrush}" Click="Stop_Click" AutomationProperties.AutomationId="StopTask"/></WrapPanel>
  <StackPanel Grid.Row="5" Margin="0,20,0,0"><Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,14"/><TextBlock Text="开始前倒计时 3 秒 · 执行时占用键鼠，相关截图发送至你选择的模型" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="HotkeyText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
 </Grid>
 </ScrollViewer>
</Window>